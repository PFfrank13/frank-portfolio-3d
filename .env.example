# Copia este archivo como `.env` y rellénalo para publicar con base de datos real (Supabase).
# Sin estas variables el sitio funciona en "modo demostración": todo se guarda solo en tu navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu-anon-key-publica...
# Correo que puede entrar al panel /#/admin (debe ser el mismo que pongas en supabase/schema.sql)
VITE_ADMIN_EMAIL=pinedaferrof@gmail.com
